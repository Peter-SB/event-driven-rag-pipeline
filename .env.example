# Copy to .env and fill in values before running docker-compose

# Postgres
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=rag
RABBITMQ_PASS=rag
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Redpanda / Kafka
# Comma-separated broker addresses
REDPANDA_SERVERS=localhost:9092

# Event bus driver: "postgres" (homelab polling) or "redpanda" (production)
EVENT_BUS=postgres
MOCK_EMBEDDINGS=0

# Observability
OTEL_ENABLED=true

# Application database URL (used by API and workers directly)
DB_URL=postgresql://rag:rag@localhost:5432/rag
RABBITMQ_URL=amqp://rag:rag@localhost:5672/

# API port
API_PORT=8000

# Optional: remote embedding endpoint — the remote_embedder_service/ FastAPI
# service running on the homelab GPU machine (port 8100 by default). Leave
# EMBED_REMOTE_URL unset to disable; the GPU worker falls back to its local
# model automatically when the endpoint is off or unreachable.
# The trailing /v1 is required: the client appends /embeddings and /models to
# this URL, and derives the native /api/* base by stripping the path.
# See docs/RemoteEmbedding.md.
EMBED_REMOTE_URL=http://100.105.195.60:8100/v1
EMBED_REMOTE_API_KEY=
EMBED_REMOTE_TIMEOUT_S=10.0
EMBED_REMOTE_HEALTH_PATH=/models
# Model-load call only (not inference). A first load downloads weights from
# HuggingFace before touching the GPU, so minutes is normal for a cold start.
EMBED_REMOTE_LOAD_TIMEOUT_S=600.0

# Deploy target for scripts/deploy.sh (homelab box running docker compose).
# The path must already contain a git clone with its own .env in place.
# DEPLOY_USER=
# DEPLOY_HOST=
# DEPLOY_PATH=

# DEPLOY_COMPOSE_FILE=docker-compose.yml
