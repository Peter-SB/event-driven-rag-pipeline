# --- remote-embedder service ---
# Copy to .env next to this file. All values shown are the defaults.

HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO

# No otel-collector on this box — the log file is the persistent record.
# Bounded to the last LOG_MAX_LINES lines, oldest dropped first, so it can't
# quietly fill the disk. Only INFO+ is written (model load/unload, warnings,
# errors); per-request access logging is disabled outright since the client
# hits GET /v1/models before every batch.
LOG_TO_FILE=1
LOG_DIR=logs
LOG_FILE=remote_embedder.log
LOG_MAX_LINES=10000

# Optional shared secret. Empty = the Authorization header is accepted and ignored,
# so a client that always sends a bearer token still works. Set it to enforce.
API_KEY=

# cuda | cpu | auto  (auto = cuda when torch reports it available)
DEVICE=auto

# Texts per forward pass. Matches GpuEmbedWorker.max_batch in the pipeline, so one
# pipeline batch is normally one pass. Larger requests are split and rejoined in order.
MAX_BATCH_SIZE=32

# Free the model's VRAM after this many idle seconds. 0 disables auto-unload.
IDLE_UNLOAD_S=300
REAPER_INTERVAL_S=15

# Allow the int8 (bitsandbytes) path for models whose registry entry asks for it.
# Set to 0 to force full precision everywhere, e.g. on a CPU-only box.
ENABLE_QUANTIZATION=1

# L2-normalise output vectors. The pipeline compares with cosine distance.
NORMALIZE_EMBEDDINGS=1

# Where HuggingFace caches downloaded weights. Point this at a roomy disk —
# Qwen3-Embedding-0.6B is ~1.2GB of safetensors.
# HF_HOME=D:/hf-cache
